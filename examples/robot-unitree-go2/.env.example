# Copy to .env. Never commit the resulting .env file.

# The dedicated physical wired NIC connected only to Go2. start.sh requires it
# to be UP with exactly 192.168.123.99/24, IPv6 disabled, no gateway, and no
# DNS. Both iproute2 and NetworkManager state are checked; nothing is changed.
# Do not use "auto", Wi-Fi, a bridge, VPN, or a virtual interface.
GO2_NETWORK_INTERFACE=enp0s31f6
GO2_ROBOT_IP=192.168.123.161
ROS_DOMAIN_ID=0

# Workspace-local Robonix Rust artifact profile. build.sh and start.sh must use
# the same value; no global/system binary fallback is allowed.
ROBONIX_BUILD_PROFILE=debug

# Runtime placement also owns every ROS publisher. Keep workstation-local for
# the existing all-on-laptop deployment. The other accepted values are:
#   workstation-full-nx-sensors  (NX --sensors-only --camera first)
#   workstation-ui-nx-full       (NX default full --camera first; UI only here)
# No automatic discovery/fallback is allowed because it could create duplicate
# camera, lidar, odom, or TF publishers.
GO2_RUNTIME_PLACEMENT=workstation-local

# Hard safety gates. Boot remains disarmed even when these are all set.
GO2_ALLOW_MOTION=false
GO2_OPERATOR_PRESENT=false
GO2_SAFETY_ACK=
# Leave empty until the stationary read-only audit records the actual
# SportModeState.mode value(s). Never guess these values.
GO2_ALLOWED_MODES=
# Leave empty unless the current non-zero SportModeState.error_code value was
# captured on this exact firmware and explicitly approved as an opaque
# compatibility marker. These numbers are not modes or proof of health.
GO2_ALLOWED_STATE_MARKERS=

# Map and deterministic semantic target data.
GO2_MAP_ID=lab_go2
GO2_MAP_MODE=localization
SEMANTIC_LANDMARKS_FILE=config/semantic_landmarks.yaml

# Bounded local Pilot endpoint for the saved-landmark robot profile. These are
# loopback protocol values, not credentials. The deployment starts and owns
# this endpoint; do not replace it with a remote general-purpose model for
# physical navigation.
SEMANTIC_INTENT_PORT=18080
VLM_BASE_URL=http://127.0.0.1:18080/v1
VLM_API_KEY=local-no-secret
VLM_MODEL=go2-semantic-router
# Owned by start.sh: preview while GO2_ALLOW_MOTION=false, live only after the
# complete motion gate. An inherited or .env value cannot override it.
# SEMANTIC_INTENT_EXECUTION_MODE=preview

# Local Chinese ASR/TTS is the default and requires no cloud key.
SPEECH_BACKEND=local
GO2_DASHBOARD_PORT=8092
# Optional local-browser push-to-talk. Keep 0 for read-only bring-up and the
# NX passive profile. Set exactly 1 only when the full workstation Robonix
# stack (Liaison + audio_client_bridge + speech) is intentionally running.
GO2_DASHBOARD_BROWSER_VOICE_ENABLED=0
