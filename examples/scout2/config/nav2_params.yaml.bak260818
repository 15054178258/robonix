# Scout2 Nav2 configuration.
# Uses robonix_nav2_terminal plugins (PersistentRotateToGoal, PersistentGoalChecker,
# GoalAwareNavfnPlanner) compiled in the nav2 Docker image.
# Scout2 chassis: 0.925 x 0.38 m; wheel outer edge: 0.827 x 0.700 m.
# Octagonal footprint covers chassis + all 4 wheels.
# max linear 0.3 m/s, max angular 0.6 rad/s.
planner_server:
  ros__parameters:
    use_sim_time: false
    expected_planner_frequency: 10.0
    planner_plugins: ["GridBased"]
    GridBased:
      plugin: "robonix_nav2_terminal::GoalAwareNavfnPlanner"
      # Accept paths with more unknown areas for better reachability
      max_unknown_ratio: 0.50
      max_unknown_length: 10.0
      max_unknown_run: 6.0
    GridBased_known:
      tolerance: 2.0
      allow_unknown: false
    GridBased_unknown:
      tolerance: 2.0
      allow_unknown: false
    tf_buffer_duration: 0.5


controller_server:
  ros__parameters:
    use_sim_time: false
    odom_topic: "__ROBONIX_ODOM_TOPIC__"
    controller_frequency: 10.0
    failure_tolerance: 5.0
    progress_checker_plugin: "progress_checker"
    goal_checker_plugins: ["general_goal_checker"]
    controller_plugins: ["FollowPath"]

    progress_checker:
      plugin: "nav2_controller::SimpleProgressChecker"
      required_movement_radius: 0.1
      movement_time_allowance: 30.0

    general_goal_checker:
      # ControllerServer resets ordinary goal checkers on every global replan.
      # This checker preserves the same-goal terminal latch with hysteresis.
      plugin: "robonix_nav2_terminal::PersistentGoalChecker"
      xy_enter_tolerance: 0.40
      xy_exit_tolerance: 0.55
      yaw_enter_tolerance: 0.25
      yaw_exit_tolerance: 0.35
      stopped_linear_velocity: 0.05
      stopped_angular_velocity: 0.05

    FollowPath:
      # Keep final-heading control inside DWB. The RotationShim experiment
      # repeatedly re-entered in-place rotation after wheel-slip changed XY.
      plugin: "dwb_core::DWBLocalPlanner"
      debug_trajectory_details: True
      min_vel_x: 0.00
      min_vel_y: 0.0
      max_vel_x: 0.3
      max_vel_y: 0.0
      max_vel_theta: 0.8
      min_speed_xy: 0.0
      max_speed_xy: 0.3
      # Include zero and very small yaw commands so the terminal latch can
      # settle instead of oscillating around a nonzero minimum speed.
      min_speed_theta: 0.1
      acc_lim_x: 0.8
      acc_lim_y: 0.0
      acc_lim_theta: 1.0
      decel_lim_x: -0.8
      decel_lim_y: -0.0
      decel_lim_theta: -1.0
      vx_samples: 20
      vy_samples: 1
      vtheta_samples: 40
      sim_time: 3.0
      linear_granularity: 0.05
      angular_granularity: 0.05
      transform_tolerance: 0.5
      xy_goal_tolerance: 0.30
      yaw_goal_tolerance: 0.12
      trans_stopped_velocity: 0.05
      short_circuit_trajectory_evaluation: True
      stateful: True
      critics: ["PersistentRotateToGoal", "Oscillation", "BaseObstacle", "GoalAlign", "PathAlign", "PathDist", "GoalDist"]
      BaseObstacle.scale: 0.02
      PathAlign.scale: 32.0
      GoalAlign.scale: 24.0
      PathDist.scale: 32.0
      GoalDist.scale: 12.0
      PersistentRotateToGoal.class: "robonix_nav2_terminal::PersistentRotateToGoalCritic"
      PersistentRotateToGoal.xy_enter_tolerance: 0.50
      PersistentRotateToGoal.xy_exit_tolerance: 0.60
      PersistentRotateToGoal.yaw_enter_tolerance: 0.50
      PersistentRotateToGoal.yaw_exit_tolerance: 0.60
      PersistentRotateToGoal.stopped_linear_velocity: 0.05
      PersistentRotateToGoal.max_terminal_angular_velocity: 0.80
      PersistentRotateToGoal.slowing_factor: 2.0
      PersistentRotateToGoal.lookahead_time: 0.3
      PersistentRotateToGoal.max_terminal_duration: 60.0
      PersistentRotateToGoal.no_progress_timeout: 15.0
      PersistentRotateToGoal.min_yaw_progress: 0.01
      PersistentRotateToGoal.rotation_margin: 1.0


bt_navigator:
  ros__parameters:
    use_sim_time: false
    bt_loop_duration: 50
    default_server_timeout: 1000
    default_bt_xml_filename: "__ROBONIX_BT_XML__"
    default_nav_to_pose_bt_xml: "__ROBONIX_BT_XML__"
    # 0.5s too short, TF lookup failures cause planning/control gaps
    tf_buffer_duration: 10.0

recoveries_server:
  ros__parameters:
    costmap_topic: global_costmap/costmap
    footprint_topic: global_costmap/published_footprint

local_costmap:
  local_costmap:
    ros__parameters:
      update_frequency: 10.0
      publish_frequency: 10.0
      global_frame: odom
      robot_base_frame: base_link
      use_sim_time: false
      rolling_window: true
      width: 5
      height: 5
      resolution: 0.05
      # Octagonal footprint covering chassis + wheels (from URDF).
      # Chassis corners: (±0.46, ±0.19). Wheel outer edges: x ±0.41, y ±0.35.
      footprint: "[[0.46, 0.19], [0.41, 0.35], [-0.41, 0.35], [-0.46, 0.19], [-0.46, -0.19], [-0.41, -0.35], [0.41, -0.35], [0.46, -0.19]]"
      footprint_padding: 0.02

      plugins: ["obstacle_layer", "inflation_layer"]
      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        footprint_clearing_enabled: true
        enabled: true
        observation_sources: scan
        scan:
          topic: "__ROBONIX_SCAN_TOPIC__"
          sensor_frame: velodyne
          max_obstacle_height: 2.0
          marking: true
          clearing: true
          obstacle_range: 5.0
          raytrace_range: 6.0
          qos:
            reliability: best_effort
            durability: volatile

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        enabled: true
        # Must be >= inscribed_radius of the octagonal footprint (~0.25m)
        inflation_radius: 0.45
        cost_scaling_factor: 3.5


global_costmap:
  global_costmap:
    ros__parameters:
      use_sim_time: false
      global_frame: map
      robot_base_frame: base_link
      # Same octagonal footprint as local_costmap (chassis + wheels)
      footprint: "[[0.46, 0.19], [0.41, 0.35], [-0.41, 0.35], [-0.46, 0.19], [-0.46, -0.19], [-0.41, -0.35], [0.41, -0.35], [0.46, -0.19]]"
      footprint_padding: 0.05
      update_frequency: 10.0
      publish_frequency: 10.0
      resolution: 0.05
      rolling_window: false
      track_unknown_space: true
      plugins: ["static_layer", "obstacle_layer", "inflation_layer"]

      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_topic: "__ROBONIX_MAP_TOPIC__"
        map_subscribe_transient_local: true
        enabled: true
        # Set to false to ignore static map obstacles (for testing only)
        # enabled: false

      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        footprint_clearing_enabled: true
        enabled: true
        observation_sources: scan
        scan:
          topic: "__ROBONIX_SCAN_TOPIC__"
          sensor_frame: velodyne
          max_obstacle_height: 2.0
          marking: true
          clearing: true
          obstacle_range: 5.0
          raytrace_range: 8.0

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        enabled: true
        inflation_radius: 0.45
        cost_scaling_factor: 3.5
      always_send_full_costmap: true


lifecycle_manager:
  ros__parameters:
    use_sim_time: false
    autostart: true
    node_names:
      - planner_server
      - controller_server
      - bt_navigator
      - recoveries_server